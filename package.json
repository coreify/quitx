{
  "name": "@coreify/quitx",
  "version": "1.2.0",
  "description": "A macOS CLI for viewing running GUI applications and quitting them properly.",
  "type": "module",
  "bin": {
    "quitx": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "license": "MIT",
  "author": "Coreify",
  "repository": {
    "type": "git",
    "url": "https://github.com/coreify/quitx.git"
  },
  "bugs": {
    "url": "https://github.com/coreify/quitx/issues"
  },
  "homepage": "https://quitx.js.org",
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "check": "npm run format && npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "test": "vitest run",
    "test:cli": "npm run build && node --experimental-strip-types tests/cli-e2e.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/core": "^1.5.1",
    "@clack/prompts": "^1.8.1",
    "execa": "^9.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "keywords": [
    "macos",
    "quit",
    "apps",
    "jxa",
    "process",
    "cli",
    "developer-tools",
    "tui"
  ]
}
